{
  "manifest_version": 3,
  "name": "简历轻填",
  "version": "2.8.0",
  "description": "分层网申填写引擎：语义匹配、控件适配、记录工作流、填写验证与本地调试报告。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "简历轻填"
  },
  "options_page": "options.html"
}
